<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone and ScreenCaptureKit audio. -->
    <key>com.apple.security.device.audio-input</key><true/>

    <!-- The calendar. The hardened runtime will not let macOS show the
         permission dialog without this: tccd refuses the request outright and
         the app is told no, with nothing on screen to say why. -->
    <key>com.apple.security.personal-information.calendars</key><true/>

    <!-- whisper-cli and the install/update helpers run as child processes, which
         the hardened runtime otherwise blocks for a notarized build. -->
    <key>com.apple.security.cs.allow-jit</key><true/>
    <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
